{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|MP4|mov|MOV|webm|jpg|JPG|jpeg|JPEG|png|PNG|gif|GIF|svg|SVG|webp|avif|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
